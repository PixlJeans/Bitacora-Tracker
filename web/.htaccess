# Bitácora Tracker (versión web)
DirectoryIndex index.html
Options -Indexes
AddType text/javascript .mjs
# Nunca servir los archivos internos
<FilesMatch "^(config\.php|.*\.json|.*\.bak|version\.txt.*)$">
  Require all denied
</FilesMatch>
# Subidas grandes (fotos / PDF)
<IfModule mod_php.c>
  php_value post_max_size 64M
  php_value upload_max_filesize 64M
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
  php_value post_max_size 64M
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
  php_value post_max_size 64M
  php_value memory_limit 256M
</IfModule>
